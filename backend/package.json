{
    "name": "healthwatch-backend",
    "version": "1.0.0",
    "description": "HealthWatch - Multi-Disease Surveillance & Early Warning System (Backend API)",
    "main": "dist/index.js",
    "scripts": {
        "dev": "nodemon --exec tsx src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "lint": "eslint . --ext ts",
        "format": "prettier --write .",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db:studio": "prisma studio",
        "db:seed": "tsx prisma/seed.ts",
        "db:clear": "node scripts/clear-db.js",
        "prisma:generate": "prisma generate",
        "prisma:db:push": "prisma db push --skip-generate",
        "prisma:seed": "tsx prisma/seed.ts",
        "postinstall": "prisma generate",
        "render-build": "npm install && npm run prisma:generate && npm run build"
    },
    "keywords": [
        "disease",
        "surveillance",
        "health",
        "early-warning"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@prisma/client": "^5.19.1",
        "arima": "^0.2.8",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "exceljs": "^4.4.0",
        "express": "^4.21.0",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.6",
        "@types/node": "^20.16.0",
        "nodemon": "^3.1.0",
        "prisma": "^5.19.1",
        "tsx": "^4.19.1",
        "typescript": "^5.6.3"
    }
}
