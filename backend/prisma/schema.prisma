// HealthWatch - Multi-Disease Surveillance & Early Warning System
// Prisma schema (MongoDB)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & Authentication
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  password     String
  firstName    String
  lastName     String
  role         String // ADMIN | HEALTH_OFFICER | FACILITY_ADMIN | PHYSICIAN | NURSE | MIDWIFE | BHW | HOSPITAL_ENCODER | RESIDENT
  barangayId   String?  @db.ObjectId
  facilityId   String?  @db.ObjectId // the facility this provider/account belongs to
  licenseNo    String? // PRC license number (ISO/TS 27527 provider identification)
  providerType String? // free-text professional designation (e.g. "Physician", "Midwife")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barangay           Barangay?         @relation(fields: [barangayId], references: [id])
  facility           Facility?         @relation(fields: [facilityId], references: [id])
  cases              Case[]
  reports            RiskReport[] @relation("RiskReportReporter")
  reviewedReports    RiskReport[] @relation("RiskReportReviewer")
  alerts             Alert[]
  auditLogs          AuditLog[]
  feedbackThreads    FeedbackThread[]  @relation("FeedbackThreadCreator")
  feedbackMessages   FeedbackMessage[] @relation("FeedbackMessageSender")
  patientsRegistered Patient[]         @relation("PatientRegisteredBy")
  encounters         Encounter[]       @relation("EncounterClinician")

  @@index([role])
  @@index([barangayId])
  @@index([facilityId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Barangays (geographic units within the municipality)
// ---------------------------------------------------------------------------
model Barangay {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String   @unique
  code         String   @unique
  municipality String
  province     String
  population   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users           User[]
  cases           Case[]
  reports         RiskReport[]
  alerts          Alert[]
  feedbackThreads FeedbackThread[]
  patients        Patient[]
  encounters      Encounter[]
  facilities      Facility[]

  @@map("barangays")
}

// ---------------------------------------------------------------------------
// Disease registry (configurable by the RHU/admin)
// ---------------------------------------------------------------------------
model Disease {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String   @unique
  code            String   @unique
  category        String // VECTOR_BORNE | WATER_BORNE | AIRBORNE | DIRECT_CONTACT | OTHER
  description     String?
  isNotifiable    Boolean  @default(true) // PIDSR notifiable disease flag
  isActive        Boolean  @default(true)
  color           String? // hex color for UI badges/charts
  seasonalMonths  Int[]    @default([]) // months (1-12) of elevated transmission
  caseThreshold   Int      @default(10) // monthly case count that escalates to HIGH
  spikePercentage Int      @default(50) // % increase vs previous month that triggers an alert
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cases     Case[]
  alerts    Alert[]
  diagnoses Diagnosis[]

  @@index([category])
  @@index([isActive])
  @@map("diseases")
}

// ---------------------------------------------------------------------------
// Cases (generalized from DengueCase to any disease)
// ---------------------------------------------------------------------------
model Case {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  diseaseId         String    @db.ObjectId
  barangayId        String    @db.ObjectId
  reportedBy        String    @db.ObjectId
  patientId         String?   @db.ObjectId // optional link to the EMR patient (kept de-identified for surveillance reads)
  sourceEncounterId String?   @db.ObjectId // encounter that auto-generated this case, if any
  facilityId        String?   @db.ObjectId // reporting facility provenance (no relation; surveillance stays facility-agnostic on read)
  autoGenerated     Boolean   @default(false) // true when created from an EMR diagnosis
  dateReported      DateTime
  onsetDate         DateTime?
  age               Int
  ageGroup          String // "0-5", "6-12", "13-18", "19-30", "31-50", "50+"
  sex               String? // MALE | FEMALE
  status            String // SUSPECTED | PROBABLE | CONFIRMED
  outcome           String    @default("ONGOING") // ONGOING | RECOVERED | DIED
  source            String // PUBLIC_HOSPITAL | PRIVATE_HOSPITAL | RHU | BHW
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  disease  Disease  @relation(fields: [diseaseId], references: [id])
  barangay Barangay @relation(fields: [barangayId], references: [id])
  reporter User     @relation(fields: [reportedBy], references: [id])
  patient  Patient? @relation(fields: [patientId], references: [id])

  @@index([diseaseId])
  @@index([barangayId])
  @@index([dateReported])
  @@index([status])
  @@index([source])
  @@index([patientId])
  @@map("cases")
}

// ---------------------------------------------------------------------------
// Risk reports (generalized from EnvironmentalReport; factors by category)
// ---------------------------------------------------------------------------
model RiskReport {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  barangayId   String   @db.ObjectId
  reportedBy   String?  @db.ObjectId
  status       String   @default("APPROVED") // PENDING | APPROVED | REJECTED
  source       String   @default("STAFF") // STAFF | RESIDENT
  category     String // VECTOR_BORNE | WATER_BORNE | AIRBORNE
  dateReported DateTime @default(now())
  submittedByName    String?
  submittedByContact String?
  reviewedBy         String?   @db.ObjectId
  reviewedAt         DateTime?
  rejectionReason    String?

  // Vector-borne factors (e.g. dengue, malaria)
  stagnantWater     Boolean @default(false)
  poorWasteDisposal Boolean @default(false)
  cloggedDrainage   Boolean @default(false)
  housingCongestion Boolean @default(false)

  // Water-borne factors (e.g. typhoid, cholera, leptospirosis)
  unsafeWaterSource Boolean @default(false)
  poorSanitation    Boolean @default(false)
  openDefecation    Boolean @default(false)
  foodContamination Boolean @default(false)

  // Airborne factors (e.g. influenza, measles, TB, COVID-19)
  overcrowding          Boolean @default(false)
  poorVentilation       Boolean @default(false)
  activeRespiratoryCase Boolean @default(false)

  photoUrl  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  barangay Barangay @relation(fields: [barangayId], references: [id])
  reporter User?    @relation("RiskReportReporter", fields: [reportedBy], references: [id])
  reviewer User?    @relation("RiskReportReviewer", fields: [reviewedBy], references: [id])

  @@index([barangayId])
  @@index([category])
  @@index([dateReported])
  @@index([status])
  @@index([source])
  @@map("risk_reports")
}

// ---------------------------------------------------------------------------
// Early-warning alerts (now per-disease per-barangay)
// ---------------------------------------------------------------------------
model Alert {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  barangayId  String    @db.ObjectId
  diseaseId   String?   @db.ObjectId
  createdBy   String?   @db.ObjectId
  title       String
  message     String
  riskLevel   String // LOW | MEDIUM | HIGH
  status      String    @default("ACTIVE") // ACTIVE | RESOLVED | DISMISSED
  triggeredAt DateTime  @default(now())
  resolvedAt  DateTime?
  metadata    String? // JSON string with supporting numbers
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  barangay Barangay @relation(fields: [barangayId], references: [id])
  disease  Disease? @relation(fields: [diseaseId], references: [id])
  creator  User?    @relation(fields: [createdBy], references: [id])

  @@index([barangayId])
  @@index([diseaseId])
  @@index([status])
  @@index([riskLevel])
  @@index([triggeredAt])
  @@map("alerts")
}

// ---------------------------------------------------------------------------
// Audit trail
// ---------------------------------------------------------------------------
model AuditLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String?  @db.ObjectId
  action       String
  resource     String?
  resourceId   String?
  details      String?
  purposeOfUse String? // TREATMENT | EMERGENCY | PUBLIC_HEALTH | ADMINISTRATIVE (ISO 27799)
  facilityId   String?  @db.ObjectId // facility context of the access
  breakGlass   Boolean  @default(false) // emergency override access (audited)
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([breakGlass])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Feedback (Barangay ↔ RHU messaging)
// ---------------------------------------------------------------------------
model FeedbackThread {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  subject       String
  barangayId    String   @db.ObjectId
  createdById   String   @db.ObjectId
  status        String   @default("OPEN") // OPEN | CLOSED
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  barangay Barangay          @relation(fields: [barangayId], references: [id])
  creator  User              @relation("FeedbackThreadCreator", fields: [createdById], references: [id])
  messages FeedbackMessage[]

  @@index([barangayId])
  @@index([createdById])
  @@index([status])
  @@index([lastMessageAt])
  @@map("feedback_threads")
}

model FeedbackMessage {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  threadId  String    @db.ObjectId
  senderId  String    @db.ObjectId
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  thread FeedbackThread @relation(fields: [threadId], references: [id])
  sender User           @relation("FeedbackMessageSender", fields: [senderId], references: [id])

  @@index([threadId])
  @@index([senderId])
  @@index([readAt])
  @@index([createdAt])
  @@map("feedback_messages")
}

// ===========================================================================
// EMR (Electronic Medical Record) — patient-centric, fully identified records.
// Feeds the de-identified surveillance Case model above.
// ===========================================================================

// ---------------------------------------------------------------------------
// Patient (Master Patient Index)
// ---------------------------------------------------------------------------
// Cross-facility patient identifiers (ISO/TS 22220 identification of subjects of care)
type PatientIdentifier {
  system String // PHILHEALTH | PHILSYS | LOCAL | OTHER
  value  String
  use    String? // OFFICIAL | SECONDARY
}

model Patient {
  id             String              @id @default(auto()) @map("_id") @db.ObjectId
  patientCode    String              @unique // municipality-wide human-readable ID, e.g. "LOPEZ-2026-0001"
  identifiers    PatientIdentifier[] // PhilHealth PIN, PhilSys, local IDs (cross-facility matching)
  firstName      String
  middleName     String?
  lastName       String
  birthDate      DateTime
  sex            String // MALE | FEMALE
  civilStatus    String? // SINGLE | MARRIED | WIDOWED | SEPARATED | OTHER
  contactNumber  String?
  address        String?
  barangayId     String?             @db.ObjectId
  homeFacilityId String?             @db.ObjectId // facility where the patient is primarily enrolled
  userId         String?             @db.ObjectId // linked portal account (RESIDENT self-access; uniqueness enforced in app)
  philhealthNo   String?
  bloodType      String?
  consentGiven   Boolean             @default(false) // Data Privacy Act (RA 10173) consent
  consentDate    DateTime?
  registeredById String?             @db.ObjectId
  isActive       Boolean             @default(true) // soft-delete flag
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  barangay        Barangay?          @relation(fields: [barangayId], references: [id])
  homeFacility    Facility?          @relation(fields: [homeFacilityId], references: [id])
  registeredBy    User?              @relation("PatientRegisteredBy", fields: [registeredById], references: [id])
  encounters      Encounter[]
  allergies       Allergy[]
  problems        Problem[]
  immunizations   Immunization[]
  maternalRecords MaternalRecord[]
  labResults           LabResult[]
  medications          Medication[]
  medicalHistoryEntries MedicalHistoryEntry[]
  cases                Case[]
  referrals            Referral[]
  consents             Consent[]
  documents            ClinicalDocument[]

  @@index([lastName])
  @@index([barangayId])
  @@index([homeFacilityId])
  @@index([userId])
  @@index([isActive])
  @@map("patients")
}

// ---------------------------------------------------------------------------
// Encounter / Visit (a single consultation)
// ---------------------------------------------------------------------------
model Encounter {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  patientId      String   @db.ObjectId
  barangayId     String?  @db.ObjectId
  facilityId     String?  @db.ObjectId // facility where care occurred (cross-facility EHR)
  clinicianId    String?  @db.ObjectId
  type           String   @default("CONSULT") // CONSULT | PRENATAL | IMMUNIZATION | TB | NCD | FOLLOWUP
  encounterDate  DateTime @default(now())
  chiefComplaint String?
  subjective     String? // S — history of present illness
  objective      String? // O — exam findings
  assessment     String? // A — clinical impression
  plan           String? // P — management plan
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient       Patient            @relation(fields: [patientId], references: [id])
  barangay      Barangay?          @relation(fields: [barangayId], references: [id])
  facility      Facility?          @relation(fields: [facilityId], references: [id])
  clinician     User?              @relation("EncounterClinician", fields: [clinicianId], references: [id])
  vitalSign     VitalSign?
  diagnoses     Diagnosis[]
  prescriptions Prescription[]
  labResults    LabResult[]
  referrals     Referral[]
  documents     ClinicalDocument[]

  @@index([patientId])
  @@index([barangayId])
  @@index([facilityId])
  @@index([encounterDate])
  @@index([type])
  @@map("encounters")
}

// ---------------------------------------------------------------------------
// Vital signs (one set per encounter)
// ---------------------------------------------------------------------------
model VitalSign {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  encounterId  String   @unique @db.ObjectId
  systolic     Int? // mmHg
  diastolic    Int? // mmHg
  temperature  Float? // °C
  heartRate    Int? // bpm
  respiratoryRate Int? // breaths/min
  weight       Float? // kg
  height       Float? // cm
  bmi          Float? // computed kg/m^2
  oxygenSat    Int? // SpO2 %
  createdAt    DateTime @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id])

  @@map("vital_signs")
}

// ---------------------------------------------------------------------------
// Diagnosis (auto-Case trigger when notifiable + confirmed)
// ---------------------------------------------------------------------------
model Diagnosis {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  encounterId String   @db.ObjectId
  diseaseId   String?  @db.ObjectId // links to the surveillance Disease registry when applicable
  icd10Code   String? // WHO ICD-10 code
  snomedCode  String? // SNOMED CT concept id (optional, standardized clinical finding)
  description String
  certainty   String   @default("CONFIRMED") // SUSPECTED | PROBABLE | CONFIRMED
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id])
  disease   Disease?  @relation(fields: [diseaseId], references: [id])

  @@index([encounterId])
  @@index([diseaseId])
  @@map("diagnoses")
}

// ---------------------------------------------------------------------------
// Prescription (with embedded line items)
// ---------------------------------------------------------------------------
type PrescriptionItem {
  drug         String
  dose         String?
  frequency    String?
  duration     String?
  instructions String?
}

model Prescription {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  encounterId String             @db.ObjectId
  items       PrescriptionItem[]
  notes       String?
  createdAt   DateTime           @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id])

  @@index([encounterId])
  @@map("prescriptions")
}

// ---------------------------------------------------------------------------
// Allergies & Problem list (patient-scoped, longitudinal)
// ---------------------------------------------------------------------------
model Allergy {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  patientId String   @db.ObjectId
  substance String
  reaction  String?
  severity  String? // MILD | MODERATE | SEVERE
  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@map("allergies")
}

model Problem {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  patientId  String    @db.ObjectId
  name       String
  status     String    @default("ACTIVE") // ACTIVE | RESOLVED | INACTIVE
  onsetDate  DateTime?
  resolvedAt DateTime?
  notes      String?
  createdAt  DateTime  @default(now())

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([status])
  @@map("problems")
}

// ---------------------------------------------------------------------------
// Immunization (EPI)
// ---------------------------------------------------------------------------
model Immunization {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  patientId      String    @db.ObjectId
  vaccine        String
  doseNumber     Int?
  dateGiven      DateTime
  nextDueDate    DateTime?
  administeredBy String?
  notes          String?
  createdAt      DateTime  @default(now())

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([dateGiven])
  @@map("immunizations")
}

// ---------------------------------------------------------------------------
// Maternal / prenatal record
// ---------------------------------------------------------------------------
model MaternalRecord {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  patientId     String    @db.ObjectId
  lmp           DateTime? // last menstrual period
  edd           DateTime? // estimated date of delivery
  gravida       Int? // number of pregnancies
  para          Int? // number of births
  prenatalVisit Int? // visit number
  visitDate     DateTime  @default(now())
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([visitDate])
  @@map("maternal_records")
}

// ---------------------------------------------------------------------------
// Laboratory / diagnostic results
// ---------------------------------------------------------------------------
model LabResult {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  patientId      String    @db.ObjectId
  encounterId    String?   @db.ObjectId
  testName       String
  loincCode      String? // LOINC code for the observation (standardized lab/observation coding)
  status         String    @default("RESULTED") // ORDERED | RESULTED | CANCELLED
  value          String?
  unit           String?
  referenceRange String?
  orderedById    String?   @db.ObjectId
  orderedAt      DateTime  @default(now())
  resultDate     DateTime  @default(now())
  notes          String?
  createdAt      DateTime  @default(now())

  patient   Patient    @relation(fields: [patientId], references: [id])
  encounter Encounter? @relation(fields: [encounterId], references: [id])

  @@index([patientId])
  @@index([encounterId])
  @@index([status])
  @@index([resultDate])
  @@map("lab_results")
}

// ---------------------------------------------------------------------------
// Active medication list (longitudinal, patient-scoped)
// ---------------------------------------------------------------------------
model Medication {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  patientId   String    @db.ObjectId
  encounterId String?   @db.ObjectId
  drug        String
  dose        String?
  frequency   String?
  route       String?
  status      String    @default("ACTIVE") // ACTIVE | DISCONTINUED
  startDate   DateTime  @default(now())
  endDate     DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([status])
  @@map("medications")
}

// ---------------------------------------------------------------------------
// Structured medical history (PMH, surgical, family, social)
// ---------------------------------------------------------------------------
model MedicalHistoryEntry {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  patientId   String   @db.ObjectId
  category    String // PMH | SURGICAL | FAMILY | SOCIAL
  description String
  notes       String?
  createdAt   DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([category])
  @@map("medical_history_entries")
}

// ===========================================================================
// EHR (Electronic Health Record) — municipality-wide, cross-facility,
// interoperable layer. Facilities, referrals, consent, documents, terminology.
// ===========================================================================

// ---------------------------------------------------------------------------
// Facility / Organization registry (every health facility in the municipality)
// ---------------------------------------------------------------------------
model Facility {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  code          String   @unique
  type          String // RHU_MAIN | BARANGAY_HEALTH_STATION | MUNICIPAL_HOSPITAL | DISTRICT_HOSPITAL | PRIVATE_CLINIC | LABORATORY | PHARMACY
  barangayId    String?  @db.ObjectId
  address       String?
  contactNumber String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  barangay      Barangay?   @relation(fields: [barangayId], references: [id])
  users         User[]
  patients      Patient[]
  encounters    Encounter[]
  referralsFrom Referral[]  @relation("ReferralFrom")
  referralsTo   Referral[]  @relation("ReferralTo")
  consents      Consent[]

  @@index([type])
  @@index([barangayId])
  @@index([isActive])
  @@map("facilities")
}

// ---------------------------------------------------------------------------
// Referral — inter-facility continuity of care (ISO 13940 ContSys)
// ---------------------------------------------------------------------------
model Referral {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  patientId       String    @db.ObjectId
  fromFacilityId  String    @db.ObjectId
  toFacilityId    String    @db.ObjectId
  encounterId     String?   @db.ObjectId
  referredById    String?   @db.ObjectId // no relation; provider provenance
  reason          String
  clinicalSummary String?
  priority        String    @default("ROUTINE") // ROUTINE | URGENT | EMERGENCY
  status          String    @default("REQUESTED") // REQUESTED | ACCEPTED | COMPLETED | REJECTED
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  patient      Patient    @relation(fields: [patientId], references: [id])
  fromFacility Facility   @relation("ReferralFrom", fields: [fromFacilityId], references: [id])
  toFacility   Facility   @relation("ReferralTo", fields: [toFacilityId], references: [id])
  encounter    Encounter? @relation(fields: [encounterId], references: [id])

  @@index([patientId])
  @@index([fromFacilityId])
  @@index([toFacilityId])
  @@index([status])
  @@map("referrals")
}

// ---------------------------------------------------------------------------
// Consent directive — governs cross-facility sharing (ISO 22600 / RA 10173)
// ---------------------------------------------------------------------------
model Consent {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  patientId           String    @db.ObjectId
  grantedToFacilityId String?   @db.ObjectId // null = all facilities participating in the HIE
  purpose             String    @default("TREATMENT") // TREATMENT | EMERGENCY | PUBLIC_HEALTH
  scope               String    @default("SUMMARY") // SUMMARY | FULL
  status              String    @default("ACTIVE") // ACTIVE | REVOKED
  validFrom           DateTime  @default(now())
  validTo             DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  patient           Patient   @relation(fields: [patientId], references: [id])
  grantedToFacility Facility? @relation(fields: [grantedToFacilityId], references: [id])

  @@index([patientId])
  @@index([grantedToFacilityId])
  @@index([status])
  @@map("consents")
}

// ---------------------------------------------------------------------------
// Clinical document (attachments / generated documents)
// ---------------------------------------------------------------------------
model ClinicalDocument {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  patientId   String   @db.ObjectId
  encounterId String?  @db.ObjectId
  facilityId  String?  @db.ObjectId // no relation; provenance only
  type        String // LAB_REPORT | REFERRAL_LETTER | DISCHARGE_SUMMARY | IMAGING | OTHER
  title       String
  format      String   @default("TEXT") // PDF | IMAGE | TEXT | FHIR
  url         String?
  content     String?
  createdById String?  @db.ObjectId // no relation; provenance only
  createdAt   DateTime @default(now())

  patient   Patient    @relation(fields: [patientId], references: [id])
  encounter Encounter? @relation(fields: [encounterId], references: [id])

  @@index([patientId])
  @@index([encounterId])
  @@map("clinical_documents")
}

// ---------------------------------------------------------------------------
// Terminology concept — standardized code systems (ICD-10, LOINC, SNOMED, ATC)
// ---------------------------------------------------------------------------
model TerminologyConcept {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  system      String // ICD10 | LOINC | SNOMED | ATC
  code        String
  display     String
  diseaseCode String? // optional link to the surveillance Disease registry code
  createdAt   DateTime @default(now())

  @@unique([system, code])
  @@index([system])
  @@map("terminology_concepts")
}
